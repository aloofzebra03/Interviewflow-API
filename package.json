{
  "name": "interviewflow-api",
  "version": "1.0.0",
  "description": "Full-stack recruiting pipeline with React, TypeScript, Node.js, Express, and PostgreSQL.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "check": "npm run lint && npm test && npm run client:build"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "rest-api",
    "jwt",
    "docker"
  ],
  "author": "Aryan Singhal",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
